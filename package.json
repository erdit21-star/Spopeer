{
  "name": "spopeer",
  "version": "1.0.0",
  "private": true,
  "description": "Spopeer Sports Social Network",
  "scripts": {
    "install:all": "npm install && cd server && npm install",
    "dev": "cd server && npm run dev",
    "start": "node server/server.js",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "syntax:check": "node scripts/syntax-check.js",
    "test": "cd server && npm test",
    "test:integration": "cd server && npx jest --config tests/jest.config.cjs --testPathPattern=integration --runInBand",
    "verify": "npm run syntax:check && npm run lint && npm run test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14"
  }
}
