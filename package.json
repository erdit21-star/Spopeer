{
  "name": "spopeer",
  "version": "1.0.0",
  "private": true,
  "description": "Spopeer Sports Social Network",
  "scripts": {
    "install:all": "npm install && cd server && npm install",
    "dev": "cd server && npm run dev",
    "start": "cd server && node server.js",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "syntax:check": "node scripts/syntax-check.js",
    "test": "cd server && npm test",
    "test:integration": "cd server && npx jest --config tests/jest.config.cjs --testPathPatterns=integration",
    "test:db": "cd server && npx jest --config tests/jest.db.config.cjs --runInBand",
    "test:e2e": "npx playwright test",
    "verify": "npm run syntax:check && npm run lint && npm run test && npm run test:db"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "@playwright/test": "^1.52.0"
  },
  "optionalDependencies": {
    "@sentry/node": "^9.0.0"
  }
}
