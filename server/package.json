{
  "name": "spopeer-server",
  "version": "1.0.0",
  "description": "Spopeer Sports Social Network - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "npx sequelize-cli db:migrate && node server.js",
    "dev": "nodemon server.js",
    "test": "jest --config tests/jest.config.cjs",
    "test:db": "jest --config tests/jest.db.config.cjs --runInBand",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:prod": "npx sequelize-cli db:migrate --env production",
    "check:launch": "node scripts/final-launch-checks.js",
    "seed": "node seeders/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.2",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "jest": "^30.2.0",
    "supertest": "^7.1.0"
  },
  "optionalDependencies": {
    "@sentry/node": "^9.0.0"
  }
}

