# ─── App ───
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
FRONTEND_URL_ALT=
# The externally-accessible site URL (used in email links etc.)
PUBLIC_SITE_URL=http://localhost:5000

# ─── Database (PostgreSQL) ───
# Prefer direct DB URL (port 5432) for Sequelize in production
# DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/spopeer
# Use DATABASE_URL in production (e.g. Railway, Render)
# DATABASE_URL=postgresql://user:pass@host:5432/spopeer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spopeer
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Auth ───
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie config (Strict or Lax; use None only with HTTPS)
COOKIE_SAME_SITE=Lax

# ─── Email Verification ───
# Set to "true" to require users to verify their email on signup.
# In production, RESEND_API_KEY is required when this is true.
REQUIRE_EMAIL_VERIFICATION=false

# ─── Google OAuth (required for "Continue with Google") ───
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Auth route timeouts/retries (AUTH_DB_OP_TIMEOUT_MS must stay below pool.acquire=10000)
GOOGLE_VERIFY_TIMEOUT_MS=10000
AUTH_DB_OP_TIMEOUT_MS=8000
GOOGLE_VERIFY_RETRIES=1
AUTH_DB_OP_RETRIES=1

# ─── File Uploads ───
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
MAX_STORY_FILE_SIZE=104857600

# ─── Admin default credentials (used by seed script) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Seed user credentials ───
SEED_ATHLETE_EMAIL=
SEED_COACH_EMAIL=
SEED_CLUB_EMAIL=
SEED_PROFESSIONAL_EMAIL=
SEED_USER_PASSWORD=

# ─── Cloudinary (REQUIRED in production for file uploads) ───
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Optional: use a single CLOUDINARY_URL instead of the three vars above:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Email via Resend (REQUIRED in production when REQUIRE_EMAIL_VERIFICATION=true) ───
# RESEND_API_KEY=re_your_api_key
# If using Resend without a verified domain, use: onboarding@resend.dev
# EMAIL_FROM=onboarding@resend.dev
# Recipient for contact, report-abuse, and careers form emails
# CONTACT_TO_EMAIL=admin@yourdomain.com

# ─── Database Repair (DANGEROUS — only for one-off schema repairs) ───
# Set to "true" to run runDatabaseRepairs() on startup. Unset or "false" in production.
RUN_DB_REPAIR_ON_BOOT=false

# ─── Sentry (optional — error tracking) ───
# SENTRY_DSN=

# ─── Redis (optional — used for shared rate-limiting and caches) ───
# REDIS_URL=redis://:password@hostname:6379
