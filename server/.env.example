# ─── App ───
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
FRONTEND_URL_ALT=

# ─── Database (PostgreSQL) ───
# Use DATABASE_URL in production (e.g. Railway, Render)
# DATABASE_URL=postgresql://user:pass@host:5432/spopeer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spopeer
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Auth ───
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── File Uploads ───
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ─── Admin default credentials (used by seed script) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Seed user credentials ───
SEED_ATHLETE_EMAIL=
SEED_COACH_EMAIL=
SEED_CLUB_EMAIL=
SEED_PROFESSIONAL_EMAIL=
SEED_USER_PASSWORD=

# ─── Cloudinary (optional - falls back to local storage) ───
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Email via Resend (REQUIRED in production — falls back to console in dev) ───
# RESEND_API_KEY=re_your_api_key
# If using Resend without a verified domain, use: onboarding@resend.dev
# EMAIL_FROM=onboarding@resend.dev
# Recipient for contact, report-abuse, and careers form emails
# CONTACT_TO_EMAIL=erditgr@yahoo.gr

# ─── Sentry (optional — error tracking) ───
# SENTRY_DSN=

# ─── Redis (optional — used for shared rate-limiting and caches) ───
# REDIS_URL=redis://:password@hostname:6379
