# ─── App ───
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
FRONTEND_URL_ALT=

# ─── Database (PostgreSQL) ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spopeer
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Auth ───
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── File Uploads ───
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ─── Admin default credentials (used by seed script) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Seed user credentials ───
SEED_ATHLETE_EMAIL=
SEED_COACH_EMAIL=
SEED_CLUB_EMAIL=
SEED_PROFESSIONAL_EMAIL=
SEED_USER_PASSWORD=

# ─── Cloudinary (optional - falls back to local storage) ───
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Email via Resend (optional - falls back to console logging) ───
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=noreply@spopeer.com
# EMAIL_FROM=

# App URL (used in email templates)
APP_URL=http://localhost:5000
